+/**
+ * A BI_BITFIELDS channel mask as a reader of one 0..255 value from a pixel; null for an empty
+ * mask, which no picture can be read with.
+ */
+function maskChannel(mask: number): ((px: number) => number) | null {
+  if (!mask) return null;
+  let shift = 0;
+  while (!((mask >>> shift) & 1)) shift++;
+  let bits = 0;
+  while (shift + bits < 32 && (mask >>> (shift + bits)) & 1) bits++;
+  const top = 2 ** bits - 1;
+  return (px) => Math.round((((px & mask) >>> shift) * 255) / top);
+}
